# Copy to .env (never commit .env). Values below are the defaults of the local
# Toolshop started by local-toolshop/start.ps1, not real credentials.

# Set to 1 to enable the "local-db" Playwright project (tests/db/) once the local
# Toolshop runs. Empty = `npx playwright test` runs only the public app tests.
LOCAL_TOOLSHOP=

LOCAL_TOOLSHOP_UI_URL=http://localhost:4200
LOCAL_TOOLSHOP_API_URL=http://localhost:8091

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=toolshop
